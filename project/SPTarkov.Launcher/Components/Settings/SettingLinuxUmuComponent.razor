@inject ConfigHelper ConfigHelper
@inject LocaleHelper LocaleHelper

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
        <div class="d-flex gap-2 align-center" style="width: 100%;">
            <MudTextField @bind-Value="UmuPath" Label="@(LocaleHelper.Get("linux_add_umu"))" Variant="Variant.Outlined" Immediate="true"
                          Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Folder"
                          AdornmentColor="Color.Info" OnAdornmentClick="SetUmuPath" Style="flex: 1;"/>
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SaveUmuPath" 
                           Disabled="UmuPath == ConfigHelper.GetConfig().LinuxSettings.UmuPath"/>
        </div>
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AddDiv { get; set; }

    private string UmuPath = string.Empty;

    protected override void OnInitialized()
    {
        UmuPath = ConfigHelper.GetConfig().LinuxSettings.UmuPath;
    }

    private string GetLinkClasses()
    {
        var classes = new CssBuilder()
            .AddClass("d-flex")
            .AddClass("justify-center")
            .AddClass("align-center")
            .AddClass("py-2")
            .AddClass("px-5");

        if (!Disabled)
        {
            classes.AddClass("cursor-pointer").AddClass("setting-on-hover");
        }

        return classes.Build();
    }

    private async Task SetUmuPath()
    {
        var file = await Launcher.App.MainWindow.ShowOpenFileAsync(title: "Choose File");

        if (!file.Any())
        {
            return;
        }
            
        UmuPath = file.FirstOrDefault()!;
        SaveUmuPath();
    }

    private void SaveUmuPath()
    {
        ConfigHelper.SetLinuxUmuPath(UmuPath);
        StateHasChanged();
    }
}
