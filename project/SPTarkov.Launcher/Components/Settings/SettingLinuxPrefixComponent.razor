@inject ConfigHelper ConfigHelper
@inject LocaleHelper LocaleHelper

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
        <div class="d-flex gap-2 align-center" style="width: 100%;">
            <MudTextField @bind-Value="PrefixPath" Label="@(LocaleHelper.Get("linux_wine_prefix"))"
                          Variant="Variant.Outlined" Immediate="true" Margin="Margin.Dense" Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Folder" AdornmentColor="Color.Info" OnAdornmentClick="SetPrefixPath"
                          Style="flex: 1;"/>
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SavePrefixPath"
                           Disabled="PrefixPath == ConfigHelper.GetConfig().LinuxSettings.PrefixPath"/>
        </div>
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AddDiv { get; set; }

    private string PrefixPath = string.Empty;

    protected override void OnInitialized()
    {
        PrefixPath = ConfigHelper.GetConfig().LinuxSettings.PrefixPath;
    }

    private string GetLinkClasses()
    {
        var classes = new CssBuilder()
            .AddClass("d-flex")
            .AddClass("justify-center")
            .AddClass("align-center")
            .AddClass("py-2")
            .AddClass("px-5");

        if (!Disabled)
        {
            classes.AddClass("cursor-pointer").AddClass("setting-on-hover");
        }

        return classes.Build();
    }

    private async Task SetPrefixPath()
    {
        var folder = await Launcher.App.MainWindow.ShowOpenFolderAsync(title: "Choose Folder");

        if (!folder.Any())
        {
            return;
        }
            
        PrefixPath = folder.FirstOrDefault()!;
        SavePrefixPath();
    }

    private void SavePrefixPath()
    {
        ConfigHelper.SetLinuxPrefixPath(PrefixPath);
        StateHasChanged();
    }
}
