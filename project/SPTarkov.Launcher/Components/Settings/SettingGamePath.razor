@inject ConfigHelper ConfigHelper
@inject LocaleHelper LocaleHelper

<MudContainer Class="pa-0">
    <MudLink Color="Color.Default" Underline="Underline.None" Disabled="Disabled" Class="@(GetLinkClasses())">
        <div class="d-flex gap-2 align-center" style="width: 100%;">
            <MudTextField @bind-Value="GamePath" Label="@(LocaleHelper.Get("setting_game_path"))" Variant="Variant.Outlined" Immediate="true"
                          Margin="Margin.Dense" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Folder" AdornmentColor="Color.Info"
                          OnAdornmentClick="SetGamePath" Style="flex: 1;"/>
            <MudIconButton Icon="@Icons.Material.Filled.Save" Color="Color.Primary" OnClick="SaveGamePath"
                           Disabled="GamePath == ConfigHelper.GetConfig().GamePath"/>
        </div>
    </MudLink>
</MudContainer>
@if (AddDiv)
{
    <MudDivider DividerType="DividerType.Middle" Class="ma-0"/>
}

@code {
    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool AddDiv { get; set; }

    private string GamePath = string.Empty;

    protected override void OnInitialized()
    {
        GamePath = ConfigHelper.GetConfig().GamePath;
    }

    private string GetLinkClasses()
    {
        var classes = new CssBuilder()
            .AddClass("d-flex")
            .AddClass("justify-center")
            .AddClass("align-center")
            .AddClass("py-2")
            .AddClass("px-5");

        if (!Disabled)
        {
            classes.AddClass("cursor-pointer").AddClass("setting-on-hover");
        }

        return classes.Build();
    }

    private async Task SetGamePath()
    {
        var folder = await Launcher.App.MainWindow.ShowOpenFolderAsync(title: "Choose Folder");

        if (!folder.Any())
            return;

        GamePath = folder.FirstOrDefault()!;
        SaveGamePath();
    }

    private void SaveGamePath()
    {
        ConfigHelper.SetGamePath(GamePath);
        StateHasChanged();
    }
}
